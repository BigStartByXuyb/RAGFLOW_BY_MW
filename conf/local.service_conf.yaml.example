# local.service_conf.yaml — LOCAL OVERRIDE TEMPLATE
#
# Copy this file to conf/local.service_conf.yaml (which is gitignored).
# Only include the top-level keys you need to override from service_conf.yaml.
# read_config() merges this file on top of service_conf.yaml at startup.
#
# Common use case: running multiple RAGFlow instances on the same machine
# (e.g. main branch + a dev worktree). Shift any port that conflicts.
#
# Example: shift Redis to 16379 to avoid colliding with another project on 6379
redis:
  db: 1
  username: ''
  password: 'infini_rag_flow'
  host: 'localhost:16379'

# Example: use a different MySQL database name for isolation
# mysql:
#   name: 'rag_flow_dev'
#   user: 'root'
#   password: 'infini_rag_flow'
#   host: 'localhost'
#   port: 3306
#   max_connections: 900
#   stale_timeout: 300
#   max_allowed_packet: 1073741824
