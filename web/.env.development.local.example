# .env.development.local — LOCAL OVERRIDE TEMPLATE
#
# Copy this file to web/.env.development.local (which is gitignored).
# This file takes precedence over .env.development during `npm run dev`.
#
# IMPORTANT: The repo default is API_PROXY_SCHEME='go' (routes many endpoints
# to the Go server on ports 9383/9384). If you are running Python-only mode
# (no Go binary), set this to 'python' so all requests go to port 9380/9381.
#
API_PROXY_SCHEME='python'
